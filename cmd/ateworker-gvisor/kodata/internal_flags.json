{
  "globalFlags": [
    "-log-format",
    "json",
    "--alsologtostderr",
    "--allow-suid",
    "--host-settings=ignore",
    "--shared-root=/var/lib/ate/runsc-shared-root"
  ],
  "commands": {
    "create": {
      "globalFlags": [
        "--cpu-num-from-quota"
      ]
    },
    "start": {
      "globalFlags": [
        "-allow-connected-on-save"
      ]
    },
    "restore": {
      "globalFlags": [
        "--cpu-num-from-quota"
      ],
      "subcommandFlags": [
        "-background",
        "-detach"
      ]
    },
    "delete": {
      "subcommandFlags": [
        "-force"
      ]
    },
    "list": {
      "subcommandFlags": [
        "-quiet"
      ]
    }
  }
}
